---
/**
 * /{c}/ratings/: the league's Elo ratings (plan §3 V9 + Elo table).
 */
import type { LeagueData } from "../../lib/data";
import { href } from "../../lib/href";
import EloTable from "./EloTable";
import LeagueChart from "./LeagueChart";

interface Props {
  data: LeagueData;
}

const { data } = Astro.props;
const { competition: comp } = data;
const clubs = data.ratings
  .filter((r) => r.elo != null)
  .map((r, i) => ({ rank: i + 1, team: r.team, elo: Math.round(r.elo!) }));
---

<div class="ratings">
  <section class="intro">
    <p>
      Every team carries an <b>Elo rating</b>. It starts at 1500, moves after every match by up to 35 points depending on
      the result and how expected it was, and carries across seasons. {
        comp.promotedElo == null
          ? "A promoted team comes back on the rating it last had (a team new to the data starts at 1500)."
          : `A promoted team restarts at ${comp.promotedElo}.`
      } The gap between two teams' ratings (plus a <b>+130 home advantage</b>) is the model's single biggest input.
    </p>
  </section>

  {
    clubs.length ? (
      <>
        <section aria-labelledby="vs-average">
          <h2 id="vs-average">Against the average</h2>
          <LeagueChart client:visible kind="ratings" clubs={clubs} league={comp.slug} leagueName={comp.name} />
          <p class="note">
            Bars run from a 1500-rated team. Each league's ratings are on their own scale, so a 1700 in one league isn't
            directly comparable with a 1700 in another. <a href={href("ratings")}>Ratings across leagues</a> puts every
            club on one scale.
          </p>
        </section>

        <section aria-labelledby="all">
          <h2 id="all">Every team</h2>
          <EloTable client:visible rows={clubs} caption={`${comp.name}: every team's Elo rating`} />
          <p class="note">Ratings after the most recent completed match.</p>
        </section>
      </>
    ) : (
      <p class="note">No {comp.name} ratings yet.</p>
    )
  }
</div>

<style>
  .ratings {
    display: grid;
    gap: 36px;
    max-width: 980px;
  }

  section {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .intro p {
    max-width: 70ch;
    margin: 0;
  }

  h2 {
    margin: 0;
    font-weight: 800;
    font-stretch: 80%;
    font-size: 22px;
  }

  .note {
    max-width: 70ch;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .note a {
    color: var(--text);
    font-weight: 600;
  }
</style>
